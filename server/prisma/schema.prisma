generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String            @id @default(cuid())
  name                  String
  email                 String            @unique
  password              String
  createdAt             DateTime          @default(now())
  currentOnboardingStep Int               @default(1)
  isOnboardingComplete  Boolean           @default(false)
  placementProfile      PlacementProfile?
}

model PlacementProfile {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  branch                    String
  year                      String
  cgpa                      Float
  companyType               String
  targetRole                String
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  aptitude                  String   @default("")
  communication             String   @default("")
  dbms                      String   @default("")
  dsa                       String   @default("")
  networks                  String   @default("")
  os                        String   @default("")
  dailyStudyHours           Int?
  preparationTimelineMonths Int?
  resumeText                String?
  resumeUrl                 String?
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
