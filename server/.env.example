# Runtime mode: development, test, or production.
NODE_ENV=development
# Render supplies PORT automatically; 8000 is the local fallback.
PORT=8000
# Existing Neon pooled PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Google Gemini API key.
GEMINI_API_KEY=replace-with-gemini-api-key
# Independent, long random secrets (generate at least 32 random bytes each).
JWT_SECRET=replace-with-long-random-access-token-secret
PASSWORD_RESET_SECRET=replace-with-different-long-random-reset-secret
# Frontend base URL used in password-reset links.
CLIENT_URL=http://localhost:3000
# Comma-separated browser origins allowed by CORS; never use * in production.
CORS_ORIGINS=http://localhost:3000
# SMTP settings. Required only to enable password-reset email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
EMAIL_FROM=AI Placement Mentor <no-reply@example.com>
# Optional placement-language behavior flag; defaults to true.
LANGUAGE_PASS_UNGROUNDED_GEMINI=true
